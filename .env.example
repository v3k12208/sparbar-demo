# Copy this file to .env and fill in. Never commit .env.
# Anthropic API key (console.anthropic.com -> API keys). Empty = mock mode with labelled demo answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to reach it from other devices, and then set DEMO_PASSWORD.
HOST=127.0.0.1
DEMO_PASSWORD=
MAX_AI_CALLS_PER_HOUR=120
MAX_TOKENS=1500
